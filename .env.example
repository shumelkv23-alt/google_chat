# БД
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/chatbot

# OpenAI (только embeddings)
OPENAI_API_KEY=sk-proj-...

# OpenRouter (все LLM-задачи)
OPENROUTER_API_KEY=sk-or-v1-...

# GCP
GCP_PROJECT_ID=your-project-id
GCP_PROJECT_NUMBER=123456789012
GOOGLE_PUBSUB_TOPIC=projects/your-project-id/topics/chat-events-topic
CHAT_A_SPACE_ID=spaces/AAAA...
CHAT_APP_AUDIENCE=123456789012

# Google OAuth (для WE API user-auth)
GOOGLE_REFRESH_TOKEN=1//0...
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# FastAPI (публичный URL ngrok / cloudflared)
APP_BASE_URL=https://xxxx.ngrok-free.app

# Redis
REDIS_URL=redis://localhost:6379/0

# Локальная разработка: отключить JWT-валидацию
SKIP_JWT_VALIDATION=true
